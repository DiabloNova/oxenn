# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oxenn
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oxenn

# Privileged (system/admin) database connection and pool size.
# Local-development example only; in production, use a dedicated least-privilege login
# role for this pool rather than reusing DATABASE_URL credentials.
# Used by src/features/admin/infrastructure/persistence/postgres for system-context leases.
AUTHENTICATOR_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oxenn
AUTHENTICATOR_POOL_MAX=2

# Test/verification-only escape hatch for registered system-context probe purposes.
# Keep disabled except during an explicitly isolated verification probe; never enable in production.
VERIFICATION_PROBE_ACTIVE=0

# Database Guard & Push Controls
ALLOW_DB_PUSH=false
DISPOSABLE_DB=false

# Authentication & Session
SESSION_SECRET=change-this-to-a-secure-32-character-secret-in-production

# Email delivery provider consumed by src/services/email.
# Leave unset until a real provider is implemented: any non-empty value enables
# ProductionEmailSender (which currently throws on send) and disables the invite-token fallback.
# EMAIL_PROVIDER=

# Application runtime mode hint consumed by scripts/env-check.ts (dev | build | migrate | test)
APP_MODE=dev

# External API Keys & AI Providers
GOOGLE_AI_API_KEY=
FIRECRAWL_API_KEY=

# Inngest Background Jobs
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Public Frontend & API URLs
NEXT_PUBLIC_API_URL=https://api.brandintelligence.ai
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_IRAN_MARKET_LOCALISED=true

# Crawler Configuration
USE_MOCK_CRAWLER=false

# Admin Security & Auth Flags
ADMIN_SSO_ENABLED=false
ADMIN_MFA_REQUIRED=true

# AI & Observability Configurations
AI_DEFAULT_MAX_TOKENS=4000
OBSERVABILITY_TRACE_SAMPLE_RATE=1.0
OBSERVABILITY_LLM_TOKEN_WARNING_THRESHOLD=3000

# Redis Rate Limiting (Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Platform Admin Control Plane — independent database and OIDC client.
# These URLs must point to a database distinct from DATABASE_URL,
# MIGRATION_DATABASE_URL, and AUTHENTICATOR_DATABASE_URL. Use separate
# migration-owner and least-privilege runtime credentials in production.
PLATFORM_ADMIN_DATABASE_URL=postgresql://platform_admin_runtime:change-me@localhost:5432/oxenn_platform_admin
PLATFORM_ADMIN_MIGRATION_DATABASE_URL=postgresql://platform_admin_migrator:change-me@localhost:5432/oxenn_platform_admin
PLATFORM_ADMIN_OIDC_ISSUER=https://identity.example.com
PLATFORM_ADMIN_OIDC_CLIENT_ID=oxenn-platform-admin
PLATFORM_ADMIN_OIDC_CLIENT_SECRET=replace-with-secret-manager-value
PLATFORM_ADMIN_OIDC_ID_TOKEN_SIGNING_ALG=RS256
PLATFORM_ADMIN_OIDC_MFA_AMR_VALUES=mfa
# Optional provider-specific assurance classes; require exact ID-token acr values.
# PLATFORM_ADMIN_OIDC_REQUIRED_ACR_VALUES=urn:example:loa:2
PLATFORM_ADMIN_OIDC_REDIRECT_URI=https://app.example.com/api/platform-admin/auth/callback
PLATFORM_ADMIN_OIDC_TRANSACTION_SECRET=replace-with-at-least-32-random-characters
PLATFORM_ADMIN_SESSION_TTL_SECONDS=28800

# One-time, operator-controlled first-admin bootstrap inputs. Set only for the
# bootstrap command, then remove them from the environment immediately.
# PLATFORM_ADMIN_BOOTSTRAP_ISSUER=
# PLATFORM_ADMIN_BOOTSTRAP_SUBJECT=
# PLATFORM_ADMIN_BOOTSTRAP_DISPLAY_NAME=
# PLATFORM_ADMIN_BOOTSTRAP_PERMISSIONS=admin:read,audit:read
