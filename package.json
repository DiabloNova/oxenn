{
  "name": "oxenn",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm exec next dev",
    "build": "pnpm exec tsx scripts/generate-docs-data.ts && pnpm exec next build",
    "start": "pnpm exec next start",
    "lint": "pnpm exec eslint",
    "typecheck": "pnpm exec tsc --noEmit",
    "test": "pnpm exec vitest run",
    "test:unit": "pnpm exec vitest run --project unit",
    "test:db": "pnpm exec vitest run --project db",
    "test:ui": "pnpm exec vitest run --project ui",
    "test:acquisition": "pnpm exec vitest run --project unit tests/unit/features/acquisition",
    "env:check": "pnpm exec tsx scripts/env-check.ts",
    "db:generate": "pnpm exec drizzle-kit generate",
    "db:migrate": "pnpm run env:check migrate && pnpm exec tsx src/core/database/migrator.ts",
    "db:push": "pnpm exec tsx scripts/database/db-push-guard.ts && pnpm exec drizzle-kit push",
    "test:isolation": "pnpm exec tsx tests/isolation/suite.ts",
    "docs:matrix": "pnpm exec tsx scripts/database/build-reference-matrix.ts",
    "docs": "pnpm run docs:matrix",
    "db:verify-rls-migrations": "pnpm exec tsx scripts/database/verify-rls-migrations.ts",
    "audit:gate": "node scripts/audit-gate.mjs",
    "test:audit-gate": "node --test scripts/audit-gate.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.99",
    "@base-ui/react": "^1.6.0",
    "@mendable/firecrawl-js": "^4.31.1",
    "@vercel/analytics": "1.6.1",
    "@xyflow/react": "^12.11.2",
    "ai": "^7.0.143",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.42.2",
    "html-to-text": "^10.0.0",
    "inngest": "^4.18.1",
    "lucide-react": "^1.26.0",
    "next": "16.4.2",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "protobufjs",
      "unrs-resolver"
    ],
    "overrides": {
      "axios": ">=1.20.0 <2",
      "js-yaml": ">=4.3.2 <5",
      "@grpc/grpc-js": ">=1.14.5 <2",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@3": "^3.0.9",
      "source-map-js@<1.2.2": "^1.2.2",
      "brace-expansion@5": "^5.0.12",
      "undici@7": ">=7.29.1 <8",
      "@mendable/firecrawl-js>zod": "4.6.7",
      "firecrawl>zod": "4.6.7",
      "systeminformation": "5.33.16"
    }
  }
}
