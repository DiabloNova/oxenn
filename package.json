{
  "name": "oxenn",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npx tsx scripts/generate-docs-data.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:acquisition": "tsx tests/features/acquisition/run-all.ts",
    "env:check": "tsx scripts/env-check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm env:check migrate && tsx src/core/database/migrator.ts",
    "db:push": "tsx scripts/database/db-push-guard.ts && drizzle-kit push",
    "test:isolation": "tsx tests/isolation/suite.ts",
    "docs:matrix": "tsx scripts/database/build-reference-matrix.ts",
    "docs": "npm run docs:matrix",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:ui": "vitest run --project ui"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.24",
    "@base-ui/react": "^1.6.0",
    "@mendable/firecrawl-js": "^4.31.1",
    "@vercel/analytics": "1.6.1",
    "@xyflow/react": "^12.11.2",
    "ai": "^7.0.37",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.42.2",
    "html-to-text": "^10.0.0",
    "inngest": "^4.18.1",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/dompurify": "^3.2.0",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.11",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
